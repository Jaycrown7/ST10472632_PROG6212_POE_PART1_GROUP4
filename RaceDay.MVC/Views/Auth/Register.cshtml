@model RaceDay.MVC.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow border-0">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold">JOIN <span class="text-warning">RACEDAY</span></h2>
                        <p class="text-muted">
                            Create your participant account and get race-ready.
                        </p>
                    </div>

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">
                                    First Name
                                </label>
                                <input asp-for="FirstName" class="form-control"
                                       placeholder="Enter first name" />
                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">
                                    Last Name
                                </label>
                                <input asp-for="LastName" class="form-control"
                                       placeholder="Enter last name" />
                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email Address
                            </label>
                            <input asp-for="Email" class="form-control"
                                   placeholder="example@email.com" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                Password
                            </label>
                            <input asp-for="Password" class="form-control"
                                   placeholder="Minimum 8 characters" />
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">
                                Confirm Password
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control"
                                   placeholder="Re-enter password" />
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">
                                Phone Number (Optional)
                            </label>
                            <input asp-for="PhoneNumber" class="form-control"
                                   placeholder="Enter phone number" />
                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="City" class="form-label">
                                City (Optional)
                            </label>
                            <input asp-for="City" class="form-control"
                                   placeholder="Enter your city" />
                            <span asp-validation-for="City"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-warning w-100 fw-bold py-2">
                            CREATE ACCOUNT
                        </button>

                    </form>

                    <div class="text-center mt-4">
                        <p class="mb-0">
                            Already have an account?
                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="fw-bold text-decoration-none">
                                Login here
                            </a>
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
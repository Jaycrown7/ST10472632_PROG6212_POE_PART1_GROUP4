@using Microsoft.AspNetCore.Http

@{
    var userId = Context.Session.GetString("UserId");
    var firstName = Context.Session.GetString("FirstName");
    var role = Context.Session.GetString("Role");
    var isLoggedIn = !string.IsNullOrEmpty(userId);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.MVC.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
            <div class="container">

                <a class="navbar-brand fw-bold fs-3"
                   asp-controller="Home"
                   asp-action="Index">
                    RACE<span class="text-warning">DAY</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="raceDayNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (!isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-warning fw-semibold px-4"
                                   asp-controller="Auth"
                                   asp-action="Register">
                                    Join RaceDay
                                </a>
                            </li>
                        }
                        else if (role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Events">
                                    Manage Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Enrolments">
                                    Enrolments
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Results">
                                    Results
                                </a>
                            </li>

                            <li class="nav-item">
                                <span class="nav-link text-warning">
                                    Hi, @firstName
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-outline-warning btn-sm ms-lg-2"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else if (role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Upcoming Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyEvents">
                                    My Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyResults">
                                    My Results
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Profile">
                                    My Profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <span class="nav-link text-warning">
                                    Hi, @firstName
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-outline-warning btn-sm ms-lg-2"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-5 py-4">
        <div class="container text-center">
            <h5 class="fw-bold">
                RACE<span class="text-warning">DAY</span>
            </h5>

            <p class="mb-1">
                Every race tells a story. Make yours count.
            </p>

            <small class="text-secondary">
                &copy; 2026 RaceDay. All rights reserved.
            </small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
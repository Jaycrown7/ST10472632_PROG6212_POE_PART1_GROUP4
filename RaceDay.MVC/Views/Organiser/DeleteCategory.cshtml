@model RaceDay.MVC.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <h2>Delete Category</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this category?
    </div>

    <div class="card bg-dark text-white mb-3">
        <div class="card-body">
            <h4>@Model.CategoryName</h4>

            <p>Distance: @Model.Distance KM</p>
            <p>Entry Fee: R @Model.EntryFee</p>
            <p>Maximum Participants: @Model.MaximumParticipants</p>
        </div>
    </div>

    <form asp-action="DeleteCategoryConfirmed" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.CategoryId" />
        <input type="hidden" name="eventId" value="@Model.EventId" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Categories"
           asp-route-eventId="@Model.EventId"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>